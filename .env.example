APP_NAME="Proposal Review"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=proposal_review
DB_USERNAME=proposal
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
# Redis, not sync: ShouldBroadcast events are queued by default, and running
# them inline would put a websocket round-trip inside the HTTP request that
# triggered them. The `queue` compose service is what consumes this — see the
# comment on that service for what breaks without it. Tests override this back
# to `sync` in phpunit.xml so the suite never needs a worker.
QUEUE_CONNECTION=redis

# Mailpit catches every outbound mail; nothing sends mail until T3.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@proposal-review.test"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

# Proposal attachments (PDFs) must stay private, never on the `public` disk.
# `local`'s `serve => true` (config/filesystems.php) also makes it the only
# disk here that supports Media::getTemporaryUrl() signed links.
MEDIA_DISK=local

# Comma-separated origins allowed to call the API.
FRONTEND_URL=http://localhost:3000

REVIEW_MAX_RATING=5
REVIEW_MIN_REVIEWS_TO_DECIDE=2
