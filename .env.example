APP_NAME="Proposal Review"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=proposal_review
DB_USERNAME=proposal
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

# Comma-separated origins allowed to call the API.
FRONTEND_URL=http://localhost:3000

REVIEW_MAX_RATING=5
REVIEW_MIN_REVIEWS_TO_DECIDE=2
